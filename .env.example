# Brevo sends the booking confirmation. The free plan stays free: 300 emails a day.
# The sender address must be verified in Brevo before mail can go out.

BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@linenhousekeeping.co.uk
BREVO_SENDER_NAME=Linen Housekeeping
BREVO_REPLY_TO=

# Inbox that receives a booking alert for every new visit.
NOTIFY_EMAIL=

PORT=3001
